generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEDICO
}

enum ReportStatus {
  PENDENTE
  CONCLUIDO
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Usuario {
  id                       String              @id @default(cuid())
  nome                     String
  login                    String              @unique
  cpf                      String?             @unique
  endereco                 String?             @db.Text
  crm                      String?             @unique
  email                    String?             @unique
  pendingEmail             String?             @map("pending_email")
  emailChangeTokenHash     String?             @unique @map("email_change_token_hash")
  emailChangeTokenExpiresAt DateTime?          @map("email_change_token_expires_at")
  senhaHash                String              @map("senha_hash")
  role                     UserRole            @default(MEDICO)
  subscriptionStatus       SubscriptionStatus  @default(PENDING_PAYMENT) @map("subscription_status")
  trialEndsAt              DateTime?           @map("trial_ends_at")
  mercadoPagoPreapprovalId String?             @unique @map("mercadopago_preapproval_id")
  mercadoPagoInitPoint     String?             @map("mercadopago_init_point") @db.Text
  mercadoPagoCardLastFour  String?             @map("mercadopago_card_last_four")
  mercadoPagoPaymentMethodId String?           @map("mercadopago_payment_method_id")
  subscriptionStartedAt    DateTime?           @map("subscription_started_at")
  subscriptionCanceledAt   DateTime?           @map("subscription_canceled_at")
  hospitalAtualId          String?             @map("hospital_atual_id")
  hospitalAtual            Hospital?           @relation(fields: [hospitalAtualId], references: [id])
  relatorios               RelatoriosFila[]
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  @@map("usuarios")
}

model Hospital {
  id            String                @id @default(cuid())
  nome          String                @unique
  larguraCm     Decimal               @map("largura_cm") @db.Decimal(8, 2)
  alturaCm      Decimal               @map("altura_cm") @db.Decimal(8, 2)
  fonteArquivo  String                @map("fonte_arquivo")
  carimboImagem String?               @map("carimbo_imagem") @db.Text
  relatorioImagem String?             @map("relatorio_imagem") @db.Text
  assinaturaImagem String?            @map("assinatura_imagem") @db.Text
  exameImagem     String?             @map("exame_imagem") @db.Text
  coordenadas   Coordenadas?
  coordenadasExame CoordenadasExame?
  usuarios      Usuario[]
  cids          Cid[]
  relatorios    RelatoriosFila[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@map("hospitais")
}

model Coordenadas {
  id                      String   @id @default(cuid())
  hospitalId              String   @unique @map("hospital_id")
  tituloXcm               Decimal  @map("titulo_x_cm") @db.Decimal(8, 2)
  tituloYcm               Decimal  @map("titulo_y_cm") @db.Decimal(8, 2)
  corpoXcm                Decimal  @map("corpo_x_cm") @db.Decimal(8, 2)
  corpoYcm                Decimal  @map("corpo_y_cm") @db.Decimal(8, 2)
  corpoMaxXcm             Decimal  @map("corpo_max_x_cm") @db.Decimal(8, 2)
  corpoLimiteInferiorYcm  Decimal  @map("corpo_limite_inferior_y_cm") @db.Decimal(8, 2)
  corpoFontePx            Decimal  @default(17) @map("corpo_fonte_px") @db.Decimal(5, 2)
  cidXcm                  Decimal  @map("cid_x_cm") @db.Decimal(8, 2)
  cidYcm                  Decimal  @map("cid_y_cm") @db.Decimal(8, 2)
  carimboXcm              Decimal  @map("carimbo_x_cm") @db.Decimal(8, 2)
  carimboYcm              Decimal  @map("carimbo_y_cm") @db.Decimal(8, 2)
  hospital                Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("coordenadas")
}

model Cid {
  id          String    @id @default(cuid())
  hospitalId  String    @map("hospital_id")
  codigo      String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([hospitalId, codigo])
  @@map("cids")
}

model CoordenadasExame {
  id                  String   @id @default(cuid())
  hospitalId          String   @unique @map("hospital_id")
  nomeXcm             Decimal  @map("nome_x_cm") @db.Decimal(8, 2)
  nomeYcm             Decimal  @map("nome_y_cm") @db.Decimal(8, 2)
  enderecoXcm         Decimal  @map("endereco_x_cm") @db.Decimal(8, 2)
  enderecoYcm         Decimal  @map("endereco_y_cm") @db.Decimal(8, 2)
  identidadeXcm       Decimal  @map("identidade_x_cm") @db.Decimal(8, 2)
  identidadeYcm       Decimal  @map("identidade_y_cm") @db.Decimal(8, 2)
  motivoXcm           Decimal  @map("motivo_x_cm") @db.Decimal(8, 2)
  motivoYcm           Decimal  @map("motivo_y_cm") @db.Decimal(8, 2)
  exameSolicitadoXcm  Decimal  @map("exame_solicitado_x_cm") @db.Decimal(8, 2)
  exameSolicitadoYcm  Decimal  @map("exame_solicitado_y_cm") @db.Decimal(8, 2)
  codigoXcm           Decimal  @map("codigo_x_cm") @db.Decimal(8, 2)
  codigoYcm           Decimal  @map("codigo_y_cm") @db.Decimal(8, 2)
  pacienteXcm         Decimal  @map("paciente_x_cm") @db.Decimal(8, 2)
  pacienteYcm         Decimal  @map("paciente_y_cm") @db.Decimal(8, 2)
  hospital            Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("coordenadas_exame")
}

model RelatoriosFila {
  id             String        @id @default(cuid())
  hospitalId     String        @map("hospital_id")
  medicoId       String?       @map("medico_id")
  pacienteNome   String        @map("paciente_nome")
  mensagemFinal  String        @map("mensagem_final") @db.Text
  cid            String?
  dataRelatorio  DateTime      @default(now()) @map("data_relatorio")
  status         ReportStatus  @default(PENDENTE)
  impressoEm     DateTime?     @map("impresso_em")
  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  medico         Usuario?      @relation(fields: [medicoId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([hospitalId, status])
  @@map("Relatorios_Fila")
}
